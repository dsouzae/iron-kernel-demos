[13.14221, "o", "\r\r\n"]
[13.143231, "o", "====================================================================\r\r\n"]
[13.14351, "o", "        iron-kernel  --  a Linux-syscall-compatible OS kernel, in Rust\r\r\n"]
[13.143559, "o", "        x86_64 . no_std . booted by GRUB/Multiboot2 . running in QEMU\r\r\n"]
[13.143764, "o", "        rootfs: a BusyBox cpio initramfs; init: go-init (a Go binary, PID 1)\r\r\n"]
[13.143818, "o", "\r\r\n"]
[13.144066, "o", "====================================================================\r\r\n"]
[14.981032, "o", "\r\r\n"]
