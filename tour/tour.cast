[31.119385, "o", ">>> 6. Container primitives: namespaces, chroot, cgroup v2 memory limits\r\r\n"]
[31.119516, "o", "\r\r\n"]
[31.11962, "o", "  $ unshare -u sh -c 'hostname pod-a; echo \"inside the new UTS namespace: $(hostname)\"'; echo \"outside, still: $(hostname)\"\r\r\n"]
[31.194637, "o", "uts: pid 153 sethostname 'pod-a' in utsns 1\r\n"]
[31.203245, "o", "inside the new UTS namespace: pod-a\r\r\n"]
[31.209349, "o", "outside, still: iron-kernel\r\r\n\r\r\n"]
[31.209424, "o", "  $ unshare -p -f sh -c 'echo \"in a new PID namespace, the shell is pid $$\"; tail -2 /proc/ironvisor/ps'\r\r\n"]
[31.283292, "o", "in a new PID namespace, the shell is pid 1\r\r\n"]
[31.319245, "o", "  156   156     6 S      0    -  0 / /proc/self/exe ns=0:156\r\r\n"]
[31.319472, "o", "  157   157   156 R      0    -  0 / /proc/self/exe ns=1:1\r\r\n"]
[31.322839, "o", "\r\r\n"]
[31.323047, "o", "  $ mkdir -p /jail/bin && cp /bin/busybox /jail/bin/ && chroot /jail /bin/busybox sh -c 'echo \"chroot: / now holds: $(busybox ls /)\"; busybox ls /bin'\r\r\n"]
[31.42192, "o", "chroot: / now holds: bin\r\r\n"]
[31.462573, "o", "busybox\r\r\n"]
[31.4645, "o", "\r\r\n"]
[31.464634, "o", "  $ mkdir /sys/fs/cgroup/oomtest; echo 33554432 > /sys/fs/cgroup/oomtest/memory.max   # 32 MiB\r\r\n"]
[31.464694, "o", "  $ /memhog     # joins the cgroup, then mmaps + touches 1 MiB chunks forever\r\r\n"]
[31.804911, "o", "OOM: killing pid 163 (/memhog), every thread of it, from tid 163: out of physical memory [SIGKILL]\r\n"]
[31.813555, "o", "memhog exited with 137  (137 = SIGKILL: the cgroup's OOM killer, not a stray SIGSEGV)\r\r\n\r\r\n"]
[31.813908, "o", "  $ cat /sys/fs/cgroup/oomtest/memory.max /sys/fs/cgroup/oomtest/memory.current 2>&1\r\r\n"]
[31.832922, "o", "33554432\r\r\n0\r\r\n"]
[33.669202, "o", "\r\r\n"]
[33.669369, "o", ">>> 7. Networking: the kernel's own TCP/IP stack on virtio-net (QEMU user-mode net)\r\r\n\r\r\n"]
[33.669446, "o", "  $ cat /proc/ironvisor/net\r\r\n"]
[33.697962, "o", "eth0 10.0.2.15/24 gw 10.0.2.2 mac 52:54:00:12:34:56 (virtio-net-pci)\r\r\nroute 0.0.0.0/0 via 10.0.2.2\r\r\nrouting: fwd 0 rerouted 0 parked 0 park-drop 0 noroute 0 notforus 0 arp-sent 0 neigh 1 fwd-drop nf 0 ttl 0 unsolicited 0\r\r\nlo 127.0.0.1/8\r\r\n"]
[33.700698, "o", "\r\r\n  $ ip route\r\r\n"]
[33.708455, "o", "default via 10.0.2.2 dev eth0 \r\r\n"]
[33.709926, "o", "10.0.2.0/24 dev eth0 scope link  src 10.0.2.15 \r\r\n"]
[33.711717, "o", "\r\r\n"]
[33.711897, "o", "  $ ping -c 2 10.0.2.2\r\r\n"]
[33.754348, "o", "PING 10.0.2.2 (10.0.2.2): 56 data bytes\r\r\n"]
[33.764541, "o", "64 bytes from 10.0.2.2: seq=0 ttl=255 time=7.834 ms\r\r\n"]
[34.683203, "o", "64 bytes from 10.0.2.2: seq=1 ttl=255 time=1.618 ms\r\r\n"]
[34.683389, "o", "\r\r\n"]
[34.683461, "o", "--- 10.0.2.2 ping statistics ---\r\r\n"]
[34.683907, "o", "2 packets transmitted, 2 packets received, 0% packet loss\r\r\n"]
[34.684131, "o", "round-trip min/avg/max = 1.618/4.726/7.834 ms\r\r\n"]
[34.690618, "o", "\r\r\n"]
[34.691421, "o", ">>> Start BusyBox httpd on :80 and fetch a page over loopback and over eth0:\r\r\n"]
[34.764001, "o", "\r\r\n  $ httpd -p 80 -h /www && echo 'httpd listening on 0.0.0.0:80'\r\r\n"]
[34.802012, "o", "httpd listening on 0.0.0.0:80\r\r\n"]
[35.719016, "o", "\r\r\n  $ wget -q -O - http://127.0.0.1:80/\r\r\n"]
[35.770617, "o", "<html><body><h1>Hello from iron-kernel</h1>\r\r\n<p>This page was served by BusyBox httpd running on an OS kernel written from scratch in Rust:\r\r\n"]
[35.770901, "o", "its own virtio-net driver, TCP/IP stack, sockets, epoll/poll, fork and execve.</p>\r\r\n</body></html>\r\r\n"]
[35.774782, "o", "\r\r\n  $ wget -S -q -O /dev/null http://10.0.2.15:80/ 2>&1 | head -3\r\r\n"]
[35.840295, "o", "  HTTP/1.1 200 OK\r\r\n"]
[35.8417, "o", "  Date: Sun, 04 Oct 2026 17:44:35 GMT\r\r\n  Connection: close\r\r\n"]
[35.844895, "o", "\r\r\n"]
[35.84509, "o", ">>> Now the HOST makes a request into the VM through QEMU's port forward (127.0.0.1:8080 -> :80):\r\r\n"]
[35.845244, "o", "### HTTPD READY ###\r\r\n\r\n  host$ curl -i http://127.0.0.1:8080/     # QEMU forwards this to the guest's :80\r\n"]
[35.864319, "o", "  HTTP/1.1 200 OK\r\n  Date: Sun, 04 Oct 2026 17:44:35 GMT\r\n  Connection: close\r\n  Content-type: text/html\r\n  Accept-Ranges: bytes\r\n  Last-Modified: Sun, 04 Oct 2026 17:44:34 GMT\r\n  ETag: \"6ac29082-ed\"\r\n  Content-Length: 237\r\n  \r\n  <html><body><h1>Hello from iron-kernel</h1>\r\n  <p>This page was served by BusyBox httpd running on an OS kernel written from scratch in Rust:\r\n  its own virtio-net driver, TCP/IP stack, sockets, epoll/poll, fork and execve.</p>\r\n  </body></html>\r\n"]
[35.864713, "o", "\r\n"]
[43.158634, "o", "\r\r\n  $ cat /proc/ironvisor/tcp\r\r\n"]
[43.206052, "o", "   ID STATE        LOCAL -> REMOTE  RXQ TXQ  POLL  GEN(rx/tx)\r\r\n"]
[43.206168, "o", "listener 3 0.0.0.0:80 backlog 9 pool listen 9 synrecv 0 est 0 other 0 ready 0 arrivals 0\r\r\n"]
[43.206353, "o", "syn-drops 0 stack-arp 0 from-table 0 reseeds 1 sockets 1 now 33623ms last:\r\r\n"]
[43.206487, "o", "EPOLL   FD  TCP EVENTS ARMED SEEN(rx/tx) SPENT QUEUED\r\r\n"]
[43.206764, "o", "virtio-net tx_free=255/256 tx_drops=0\r\r\n"]
[44.128413, "o", "\r\r\n====================================================================\r\r\n"]
[44.128616, "o", "   One kernel, written from scratch in Rust: paging, scheduling, signals,\r\r\n"]
[44.128817, "o", "   VFS + ext2 on virtio-blk + tmpfs + procfs, namespaces, cgroups, a TCP/IP\r\r\n"]
[44.128901, "o", "   stack -- running unmodified BusyBox, musl and Go binaries, and serving\r\r\n"]
[44.129047, "o", "   HTTP to the host.\r\r\n"]
[44.129135, "o", "   The Kubernetes capstone (CRI-O + kubelet + kube-proxy) is in demo/demo.sh.\r\r\n"]
[44.129228, "o", "\r\r\n"]
[44.129295, "o", "====================================================================\r\r\n"]
[45.048394, "o", "\r\r\n### DEMO COMPLETE ###\r\r\n"]
