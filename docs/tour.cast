[0.015201, "o", "booting iron-kernel under qemu-system-x86_64 (tcg, -m 1024M; host :8080 -> guest :80)\r\n\r\n"]
[10.276534, "o", "  iron-kernel v0.1.0 - x86_64\r\n"]
[10.283144, "o", "Physical memory: 257187 frames free (1004 MB)\r\n"]
